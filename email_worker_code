export default {
  async email(message, env, ctx) {
    console.log("EMAIL TRIGGERED");

    ctx.waitUntil(handleEmail(message));
  }
};

async function handleEmail(message) {
  try {
    console.log("Processing email");

    const res = await fetch("https://YOUR_IP/receive-email", {
      method: "POST",
      headers: {
        "Content-Type": "application/json"
      },
      body: JSON.stringify({
        to: message.to,
        from: message.from,
        subject: message.headers.get("subject"),
        body: "test"
      })
    });

    console.log("STATUS:", res.status);

  } catch (err) {
    console.log("FETCH ERROR:", err);
  }
}

function extractBody(raw) {
  try {
    // Extract base64
    const base64Match = raw.match(
      /Content-Transfer-Encoding: base64\s+([\s\S]*?)--/
    );

    if (base64Match && base64Match[1]) {
      const cleaned = base64Match[1].replace(/\r?\n/g, "").trim();

      try {
        const binary = atob(cleaned);
        const bytes = Uint8Array.from(binary, c => c.charCodeAt(0));
        let text = new TextDecoder("utf-8").decode(bytes);

        // ✅ CLEAN TEXT
        text = text.replace(/\r\n|\n|\r/g, " ");
        text = text.replace(/\s+/g, " ").trim();

        return text;
      } catch {}
    }

    // Quoted-printable fallback
    const qpMatch = raw.match(
      /Content-Transfer-Encoding: quoted-printable\s+([\s\S]*?)--/
    );

    if (qpMatch && qpMatch[1]) {
      let text = qpMatch[1];

      text = text.replace(/=([A-F0-9]{2})/gi, (_, hex) =>
        String.fromCharCode(parseInt(hex, 16))
      );

      text = text.replace(/<[^>]+>/g, "");

      // ✅ CLEAN TEXT
      text = text.replace(/\r\n|\n|\r/g, " ");
      text = text.replace(/\s+/g, " ").trim();

      return text;
    }

    return "No readable content";

  } catch (e) {
    return "Parsing failed";
  }
}